<!-- DFTDesk's own shell, using a subset of MIT-licensed upstream styles. -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DFTDesk.CrystalShell"
             FontSize="14" FontFamily="{DynamicResource AppFontFamily}"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Styles>
    <Style Selector="Border#DropZone">
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2"/>
          <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="BackEaseOut"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border#DropZone.over">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="RenderTransform" Value="scale(1.015)"/>
    </Style>
    <Style Selector="Button.theme-tab">
      <Setter Property="Padding" Value="13,8"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
      <Setter Property="CornerRadius" Value="{DynamicResource SoftRadius}"/>
    </Style>
    <Style Selector="Button.theme-tab.selected">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="Button.theme-swatch">
      <Setter Property="Padding" Value="2"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style Selector="Button.theme-swatch.selected">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="Auto,*">
    <Border x:Name="NavPane" Classes="navpane" Width="230" ClipToBounds="True"
            Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel x:Name="NavDock" Margin="14,18">
        <StackPanel DockPanel.Dock="Top" Classes="navheader" Orientation="Horizontal" Spacing="10">
          <Image Source="avares://DFTDesk/Assets/Icons/dftdesk.png" Width="30" Height="30"/>
          <StackPanel x:Name="BrandText" VerticalAlignment="Center">
            <TextBlock Text="DFTDesk" FontSize="18" FontWeight="Bold"/>
            <TextBlock Classes="caption" Text="DFT 文件与数据工具"/>
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="4,12,4,0">
          <Grid ColumnDefinitions="*,6,*" x:Name="NavFooterButtons">
            <Button Classes="navlink" Click="OnGitHub" HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                <PathIcon Data="{StaticResource Icon.GitHub}" Width="13" Height="13"/>
                <TextBlock Text="DFTDesk"/>
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="navlink" Click="OnSponsor" ToolTip.Tip="赞助 DFTDesk" HorizontalAlignment="Stretch">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                <PathIcon Data="{StaticResource Icon.Heart}" Width="13" Height="13" Foreground="#D4537E"/>
                <TextBlock Text="赞助"/>
              </StackPanel>
            </Button>
          </Grid>
          <TextBlock x:Name="VersionText" Classes="caption" Margin="8,0" Text="版本 2.0.0"/>
        </StackPanel>
        <StackPanel x:Name="CollapsedFooter" DockPanel.Dock="Bottom" Spacing="8" IsVisible="False">
          <Button Classes="navlink" Click="OnGitHub" ToolTip.Tip="DFTDesk" Padding="8,6">
            <PathIcon Data="{StaticResource Icon.GitHub}" Width="13" Height="13"/>
          </Button>
          <Button Classes="navlink" Click="OnSponsor" ToolTip.Tip="赞助 DFTDesk" Padding="8,6">
            <PathIcon Data="{StaticResource Icon.Heart}" Width="13" Height="13" Foreground="#D4537E"/>
          </Button>
        </StackPanel>
        <Button DockPanel.Dock="Bottom" Classes="icon navtoggle" Margin="0,8,0,0"
                Click="OnToggleNavigation" ToolTip.Tip="收起或展开侧边栏">
          <PathIcon Data="{StaticResource Icon.Sidebar}" Width="17" Height="17"/>
        </Button>
        <ListBox x:Name="Navigation" Classes="nav" SelectedIndex="0"
                 SelectionChanged="OnNavigationChanged">
          <ListBoxItem>
            <Border Background="Transparent" Padding="12,9">
              <StackPanel Classes="navitem" Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="navicon" Data="{StaticResource Icon.Home}" Width="17" Height="17"/>
                <TextBlock Text="首页" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </ListBoxItem>
          <ListBoxItem>
            <Border Background="Transparent" Padding="12,9">
              <StackPanel Classes="navitem" Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="navicon" Data="{StaticResource Icon.Folder}" Width="17" Height="17"/>
                <TextBlock Text="结构文件格式转换" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </ListBoxItem>
          <ListBoxItem>
            <Border Background="Transparent" Padding="12,9">
              <StackPanel Classes="navitem" Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="navicon" Data="{StaticResource Icon.Engine}" Width="17" Height="17"/>
                <TextBlock Text="团簇生成" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </ListBoxItem>
          <ListBoxItem>
            <Border Background="Transparent" Padding="12,9">
              <StackPanel Classes="navitem" Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="navicon" Data="{StaticResource Icon.Tune}" Width="17" Height="17"/>
                <TextBlock Text="DOS 分析" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </ListBoxItem>
          <ListBoxItem>
            <Border Background="Transparent" Padding="12,9">
              <StackPanel Classes="navitem" Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="navicon" Data="{StaticResource Icon.Tune}" Width="17" Height="17"/>
                <TextBlock Text="COHP / ICOHP 分析" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </ListBoxItem>
          <ListBoxItem>
            <Border Background="Transparent" Padding="12,9">
              <StackPanel Classes="navitem" Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="navicon" Data="{StaticResource Icon.Palette}" Width="17" Height="17"/>
                <TextBlock Text="主题" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </ListBoxItem>
          <ListBoxItem>
            <Border Background="Transparent" Padding="12,9">
              <StackPanel Classes="navitem" Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="navicon" Data="{StaticResource Icon.Settings}" Width="17" Height="17"/>
                <TextBlock Text="工作引擎" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </ListBoxItem>
          <ListBoxItem>
            <Border Background="Transparent" Padding="12,9">
              <StackPanel Classes="navitem" Orientation="Horizontal" Spacing="12">
                <PathIcon Classes="navicon" Data="{StaticResource Icon.Info}" Width="17" Height="17"/>
                <TextBlock Text="关于" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </ListBoxItem>
        </ListBox>
      </DockPanel>
    </Border>

    <Border Grid.Column="1" Background="{DynamicResource PageBrush}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ContentControl x:Name="PageHost" Classes="page"
                        Margin="32,26,32,32" HorizontalAlignment="Stretch" MaxWidth="980">
        <Grid x:Name="PageContainer">
          <!-- DFTDesk home is a dashboard, never a second file-conversion interface. -->
          <StackPanel x:Name="HomePage" Spacing="20">
            <Border Background="{DynamicResource AccentFaintBrush}" CornerRadius="20" Padding="28"
                    BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
              <StackPanel Spacing="13">
                <TextBlock Classes="caption" Text="DFTDESK / COMPUTATIONAL MATERIALS" FontWeight="SemiBold"/>
                <TextBlock Text="DFTDesk 2.0" FontSize="34" FontWeight="Bold"/>
                <TextBlock Text="计算材料结构工作台" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="晶体结构转换 · 团簇生成 · DOS / COHP / ICOHP 分析。输入文件均在本机处理。"/>
              </StackPanel>
            </Border>
            <TextBlock Classes="h2" Text="开始使用"/>
            <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto">
              <Border Grid.Column="0" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="结构文件格式转换"/>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="POSCAR / CONTCAR ⇄ CIF。拖放、多选、批量输出与环形轮盘在一个页面完成。"/>
                  <Button HorizontalAlignment="Left" Content="进入转换工具" Click="OnGoConversion"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="团簇生成"/>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="任意元素、批量原子数、普通几何或 FCC 晶面取向；同时生成 POSCAR 和 CIF。"/>
                  <Button HorizontalAlignment="Left" Content="进入团簇生成" Click="OnGoCluster"/>
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="0" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="DOS / PDOS 分析"/>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="VASP DOSCAR / vasprun.xml；元素和轨道投影、自旋分辨、d 带中心及 Excel / Origin 导出。"/>
                  <Button HorizontalAlignment="Left" Content="进入 DOS 分析" Click="OnGoDos"/>
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="2" Classes="card">
                <StackPanel Spacing="10">
                  <TextBlock Classes="h2" Text="COHP / ICOHP 分析"/>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="LOBSTER 化学键 COHP 曲线、ICOHP(Ef) 键强度、Excel 和 Origin 数据导出。"/>
                  <Button HorizontalAlignment="Left" Content="进入 COHP 分析" Click="OnGoCohp"/>
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="工作引擎"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="ASE、pymatgen、NumPy、Matplotlib、openpyxl 分别安装与检测，共用一个 Python 环境。"/>
                <Button HorizontalAlignment="Left" Content="配置 / 检测工作引擎" Click="OnGoEngine"/>
              </StackPanel>
            </Border>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="使用提醒：团簇结果为几何初猜，需经过 VASP 优化；结构转换后请核对原子顺序与约束。DOS/PDOS 推荐使用收敛后的静态计算结果。"/>
          </StackPanel>

          <StackPanel x:Name="ConversionPage" Spacing="16" IsVisible="False">
            <TextBlock Classes="h1" Text="结构文件格式转换"/>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="使用 ASE 统一管理结构文件导入、批量转换和结果保存。支持 POSCAR、CONTCAR 与 CIF。"/>
            <Border Background="{DynamicResource AccentFaintBrush}" CornerRadius="12" Padding="12,10">
              <TextBlock TextWrapping="Wrap"
                         Text="提示：在 Windows 资源管理器中按住 Ctrl 并左键拖动结构文件，可呼出轮盘快捷转换。"/>
            </Border>
            <!-- One shared surface: cloud importer when empty, the actual list when files exist. -->
            <Border x:Name="DropZone" DragDrop.AllowDrop="True" Cursor="Arrow"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource AccentSoftBrush}"
                    BorderThickness="1.5" CornerRadius="{DynamicResource SoftRadiusLarge}" Padding="16">
              <Grid>
                <StackPanel x:Name="EmptyImportPanel" Spacing="8" HorizontalAlignment="Stretch">
                  <Button x:Name="ImportCloudButton" Classes="ghost"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                          MinHeight="150" Click="OnBrowseFiles"
                          ToolTip.Tip="点击添加 POSCAR、CONTCAR、CIF 文件，或直接拖放文件">
                    <StackPanel Spacing="7" HorizontalAlignment="Center">
                      <TextBlock Text="☁" FontSize="42" Foreground="{DynamicResource AccentBrush}"
                                 TextAlignment="Center" HorizontalAlignment="Center"/>
                      <TextBlock Text="点击云朵添加结构文件，或将文件拖入此处"
                                 FontSize="15" FontWeight="SemiBold" TextAlignment="Center"/>
                      <TextBlock Classes="caption" Text="支持 POSCAR、CONTCAR、CIF；可多选"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
                <StackPanel x:Name="ImportedFilesPanel" Spacing="11" IsVisible="False">
                  <DockPanel>
                    <TextBlock x:Name="ImportedFilesCount" Text="已导入 0 个结构文件"
                               DockPanel.Dock="Left" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Spacing="9">
                    <Button Classes="accent" Content="＋ 添加文件" Click="OnBrowseFiles"/>
                    <Button Content="移除选中" Click="OnRemoveSelected"/>
                    <Button Content="清空列表" Click="OnClearFiles"/>
                  </StackPanel>
                  <ListBox x:Name="FileList" MinHeight="140" MaxHeight="260"
                           SelectionMode="Multiple"/>
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="可继续添加文件，或选择列表中的项目移除。清空后恢复云朵导入区。"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="导出格式"/>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Button Classes="accent" Content="转换为 CIF" Click="OnExportCif"/>
                  <Button Content="转换为 POSCAR" Click="OnExportPoscar"/>
                </StackPanel>
                <CheckBox x:Name="CartesianOption" IsChecked="True"
                          Content="POSCAR 使用 Cartesian 坐标（默认）"/>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="取消勾选则使用 Direct 分数坐标；只影响 POSCAR 输出。"/>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="结果保存位置"/>
                <TextBlock Classes="caption" Text="留空则在原文件目录生成结果；已有同名文件不会被覆盖。"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="浏览…" Click="OnBrowseFolder" Margin="8,0,0,0"/>
                  <TextBox x:Name="OutputDirectory" PlaceholderText="默认：源文件所在目录"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="转换进度与历史"/>
                <TextBlock x:Name="BatchStatus" Classes="muted" Text="已选择 0 个文件"/>
                <ProgressBar x:Name="BatchProgress" Minimum="0" Maximum="100" Value="0"/>
                <Button x:Name="CancelConversionButton" Content="取消转换" HorizontalAlignment="Left"
                        Click="OnCancelConversion" IsEnabled="False"/>
                <DockPanel Margin="0,8,0,0">
                  <Button DockPanel.Dock="Right" Classes="ghost" Click="OnClearHistory" Content="清除历史"/>
                  <TextBlock Classes="h2" VerticalAlignment="Center" Text="最近的转换"/>
                </DockPanel>
                <TextBlock x:Name="HistoryEmpty" Classes="muted" Text="转换后的文件会显示在这里。"/>
                <StackPanel x:Name="HistoryRecords" Spacing="8"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ClusterPage" Spacing="16" IsVisible="False">
            <TextBlock Classes="h1" Text="团簇生成"/>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="基于 ASE 的几何初猜：普通团簇或具有 FCC(111)/(100)/(110) 局部取向的有限团簇。"/>
            <Border Classes="card">
              <StackPanel Spacing="13">
                <TextBlock Classes="h2" Text="构型参数"/>
                <Grid ColumnDefinitions="*,18,*">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="团簇元素"/>
                    <TextBox x:Name="ClusterElement" Text="Pt" Watermark="如 Pt、Fe、Ni、Au"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Classes="label" Text="原子数量（支持批量和范围）"/>
                    <TextBox x:Name="ClusterNumbers" Text="4,5,6,13" Watermark="如 4,5,6,13 或 4:12:2"/>
                  </StackPanel>
                </Grid>
                <TextBlock Classes="label" Text="团簇类型"/>
                <ComboBox x:Name="ClusterMode" SelectedIndex="0" Width="330"
                          HorizontalAlignment="Left" SelectionChanged="OnClusterModeChanged">
                  <ComboBoxItem Content="普通团簇（自动初猜）"/>
                  <ComboBoxItem Content="FCC 晶面取向团簇"/>
                </ComboBox>
                <StackPanel x:Name="FacetOptionsPanel" Spacing="10" IsVisible="False">
                  <TextBlock Classes="label" Text="晶面类型"/>
                  <TextBox x:Name="ClusterFacets" Text="all" Watermark="all 或 111,100,110,ico"/>
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="all = FCC(111)、FCC(100)、FCC(110)；也可填单个或组合。ico 只支持 13/55/147/309/561/923 原子。"/>
                  <TextBlock Classes="label" Text="FCC 晶格常数 a (Å，可留空自动估算)"/>
                  <TextBox x:Name="ClusterLatticeConstant" Watermark="留空按 ASE 元素参考值或共价半径估算"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,18,*">
                  <StackPanel Spacing="6">
                    <TextBlock Classes="label" Text="每侧真空厚度 (Å)"/>
                    <TextBox x:Name="ClusterVacuum" Text="12"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Classes="label" Text="POSCAR 坐标"/>
                    <CheckBox x:Name="ClusterCartesian" IsChecked="True"
                              Content="Cartesian（默认，取消则 Direct）"/>
                  </StackPanel>
                </Grid>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="晶格常数/初始原子距离自动估算；非 FCC 元素的晶面团簇采用假设 FCC 初猜，不能代表真实稳定晶相。"/>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="输出文件"/>
                <TextBlock Classes="caption" Text="每个团簇生成 POSCAR 与 CIF 两个文件，保存于自动创建的独立文件夹，不覆盖已有结果。"/>
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="浏览…" Click="OnClusterBrowse" Margin="8,0,0,0"/>
                  <TextBox x:Name="ClusterOutputDirectory" Watermark="默认：文档文件夹"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button x:Name="ClusterGenerateButton" Classes="accent" Content="生成团簇" Click="OnGenerateCluster"/>
                  <Button x:Name="ClusterCancelButton" Content="取消生成" Click="OnCancelCluster" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="ClusterStatus" Classes="muted" Text="填写参数后点击生成团簇。"/>
                <TextBox x:Name="ClusterLog" AcceptsReturn="True" IsReadOnly="True"
                         TextWrapping="Wrap" MinHeight="135" MaxHeight="260"
                         Watermark="生成记录、输出路径与异常信息将在此显示。"/>
              </StackPanel>
            </Border>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="注意：输出仅为初始构型，需要进行 VASP 结构弛豫和真空层收敛测试；小团簇的晶面仅指局部几何取向。"/>
          </StackPanel>

          <StackPanel x:Name="DosPage" Spacing="16" IsVisible="False">
            <TextBlock Classes="h1" Text="DOS / PDOS 分析"/>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="读取 VASP DOSCAR 或 vasprun.xml，按元素和 s/p/d 轨道筛选，自旋分辨绘图并计算 d 带中心。"/>
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="导入 VASP 电子态密度"/>
                <Button Classes="accent" HorizontalAlignment="Left" Content="选择 DOSCAR / vasprun.xml" Click="OnDosBrowse"/>
                <TextBlock x:Name="DosInputFile" Classes="muted" TextWrapping="Wrap" Text="尚未导入 DOS 数据"/>
                <TextBlock x:Name="DosMetadataStatus" Classes="caption" TextWrapping="Wrap"
                           Text="DOSCAR 按元素分辨 PDOS 需要同目录 POSCAR 或 CONTCAR；优先推荐 vasprun.xml。"/>
                <TextBlock Classes="label" Text="选择元素（Ctrl / Shift 可多选；默认选 Pt、Fe、Co、Ni）"/>
                <ListBox x:Name="DosElementList" SelectionMode="Multiple" MinHeight="65" MaxHeight="145"/>
                <TextBlock Classes="label" Text="轨道投影"/>
                <StackPanel Orientation="Horizontal" Spacing="18">
                  <CheckBox x:Name="DosOrbitalS" Content="s" IsChecked="True"/>
                  <CheckBox x:Name="DosOrbitalP" Content="p" IsChecked="True"/>
                  <CheckBox x:Name="DosOrbitalD" Content="d" IsChecked="True"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,12,*,12,*">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="label" Text="自旋通道"/>
                    <ComboBox x:Name="DosSpinMode" SelectedIndex="0">
                      <ComboBoxItem Content="↑ + ↓（下自旋镜像）"/>
                      <ComboBoxItem Content="仅 ↑"/>
                      <ComboBoxItem Content="仅 ↓"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Classes="label" Text="能量下限（eV，相对 Ef）"/>
                    <TextBox x:Name="DosEnergyMin" Text="-8"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4" Spacing="5">
                    <TextBlock Classes="label" Text="能量上限（eV，相对 Ef）"/>
                    <TextBox x:Name="DosEnergyMax" Text="4"/>
                  </StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Button x:Name="DosAnalyzeButton" Classes="accent" Content="分析并绘图" Click="OnDosAnalyze"/>
                  <Button x:Name="DosExportButton" Content="导出 Excel / Origin DAT / CSV / PNG / SVG" Click="OnDosExport" IsEnabled="False"/>
                  <Button x:Name="DosCancelButton" Content="取消分析" Click="OnDosCancel" IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="DosStatus" Classes="muted" TextWrapping="Wrap"
                           Text="请先选择 DOS 数据文件。"/>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="DOS 曲线预览"/>
                <TextBlock x:Name="DosPlotPlaceholder" Classes="caption"
                           Text="分析完成后在此显示 TDOS / PDOS 曲线。"/>
                <Image x:Name="DosPlotImage" Height="480" Stretch="Uniform" IsVisible="False"/>
                <TextBlock Classes="h2" Text="积分与 d 带中心"/>
                <TextBox x:Name="DosSummary" AcceptsReturn="True" IsReadOnly="True"
                         TextWrapping="Wrap" MinHeight="105" MaxHeight="230"
                         Text="d 带中心按选定能量区间计算，以费米能级为 0 eV；自旋上下分开统计。"/>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="曲线按元素汇总所有对应原子；CSV 中 DOS 保留物理正值，图中 spin-down 为方便比较显示为负值。"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Dedicated LOBSTER bonding analysis page, separate from VASP DOS. -->
          <StackPanel x:Name="CohpPage" Spacing="16" IsVisible="False">
            <TextBlock Classes="h1" Text="COHP / ICOHP 分析"/>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="从 LOBSTER 的 COHPCAR / ICOHPLIST 按键分析成键贡献、反键贡献、积分曲线与费米能级处的 ICOHP。"/>
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="导入 LOBSTER 数据"/>
                <Button Classes="accent" HorizontalAlignment="Left"
                        Content="选择 COHPCAR / ICOHPLIST" Click="OnCohpBrowse"/>
                <TextBlock x:Name="CohpInputFile" Classes="muted" TextWrapping="Wrap"
                           Text="尚未导入 COHP 数据"/>
                <TextBlock x:Name="CohpMetadataStatus" Classes="caption" TextWrapping="Wrap"
                           Text="优先导入 COHPCAR.lobster；同目录下的 ICOHPLIST.lobster 将自动读取。只有 ICOHPLIST 时仍可导出键强度表。"/>
                <TextBlock Classes="label" Text="选择键（Ctrl / Shift 多选；默认选第一个键）"/>
                <ListBox x:Name="CohpBondList" SelectionMode="Multiple" MinHeight="110" MaxHeight="210"/>
                <Grid ColumnDefinitions="*,12,*,12,*">
                  <StackPanel Spacing="5">
                    <TextBlock Classes="label" Text="自旋通道"/>
                    <ComboBox x:Name="CohpSpinMode" SelectedIndex="0">
                      <ComboBoxItem Content="↑ + ↓"/>
                      <ComboBoxItem Content="仅 ↑"/>
                      <ComboBoxItem Content="仅 ↓"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="5">
                    <TextBlock Classes="label" Text="能量下限（eV，相对 Ef）"/>
                    <TextBox x:Name="CohpEnergyMin" Text="-8"/>
                  </StackPanel>
                  <StackPanel Grid.Column="4" Spacing="5">
                    <TextBlock Classes="label" Text="能量上限（eV，相对 Ef）"/>
                    <TextBox x:Name="CohpEnergyMax" Text="4"/>
                  </StackPanel>
                </Grid>
                <CheckBox x:Name="CohpNegative" Content="绘图采用 -COHP / -ICOHP（成键显示为正，导出仍保留原始数值）"
                          IsChecked="True"/>
                <StackPanel Orientation="Horizontal" Spacing="9">
                  <Button x:Name="CohpAnalyzeButton" Classes="accent"
                          Content="分析并绘图" Click="OnCohpAnalyze"/>
                  <Button x:Name="CohpExportButton" Content="导出 Excel / Origin DAT / CSV / 图片"
                          Click="OnCohpExport" IsEnabled="False"/>
                  <Button x:Name="CohpCancelButton" Content="取消" Click="OnCohpCancel"
                          IsEnabled="False"/>
                </StackPanel>
                <TextBlock x:Name="CohpStatus" Classes="muted" TextWrapping="Wrap"
                           Text="请先选择 LOBSTER 的 COHPCAR 或 ICOHPLIST。"/>
              </StackPanel>
            </Border>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="COHP 与 ICOHP 曲线"/>
                <TextBlock x:Name="CohpPlotPlaceholder" Classes="caption" TextWrapping="Wrap"
                           Text="读取 COHPCAR 后，分析结果将在此显示；仅 ICOHPLIST 则提供积分键强度表。"/>
                <Image x:Name="CohpPlotImage" Height="490" Stretch="Uniform" IsVisible="False"/>
                <TextBlock Classes="h2" Text="ICOHP(Ef) 与键分析"/>
                <TextBox x:Name="CohpSummary" AcceptsReturn="True" IsReadOnly="True"
                         TextWrapping="Wrap" MinHeight="140" MaxHeight="280"
                         Text="ICOHP(Ef) 越负通常代表成键贡献越强；需结合键长、轨道投影和体系条件解释。"/>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Excel 包含键强度表及可用的完整曲线；Origin DAT 为可直接导入的制表符数据，不是 Origin 原生工程 .opju。"/>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- DFTDesk compact theme settings. -->
          <StackPanel x:Name="ThemePage" IsVisible="False" Spacing="16">
            <TextBlock Classes="h1" Text="主题"/>
            <TextBlock Classes="muted" Text="自定义外观、颜色、圆角、透明度、动画和窗口大小。"/>
            <Border Classes="card">
              <StackPanel Spacing="18">
                <Grid ColumnDefinitions="220,*" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h2" Text="外观"/>
                    <TextBlock Classes="caption" Text="选择界面浅色、深色或跟随系统。"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Button x:Name="AppearanceSystemButton" Classes="theme-tab" Content="跟随系统" Click="OnAppearanceSystem"/>
                    <Button x:Name="AppearanceLightButton" Classes="theme-tab" Content="浅色" Click="OnAppearanceLight"/>
                    <Button x:Name="AppearanceDarkButton" Classes="theme-tab" Content="深色" Click="OnAppearanceDark"/>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource SubtleBorderBrush}"/>
                <Grid ColumnDefinitions="220,*" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h2" Text="强调色"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="用于按钮、选中状态及其他关键控件。"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <WrapPanel x:Name="AccentSwatches" HorizontalAlignment="Left"/>
                    <TextBox x:Name="AccentHex" Width="115" Watermark="#7F77DD"
                             LostFocus="OnAccentHexCommit"/>
                  </StackPanel>
                </Grid>
                <Border Height="1" Background="{DynamicResource SubtleBorderBrush}"/>
                <Grid ColumnDefinitions="220,*" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h2" Text="圆角"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="调整按钮、输入框与卡片的圆角。"/>
                  </StackPanel>
                  <Grid Grid.Column="1" ColumnDefinitions="*,78" ColumnSpacing="14" VerticalAlignment="Center">
                    <Slider x:Name="CornerSlider" Minimum="0" Maximum="28" Value="16"
                            VerticalAlignment="Center" ValueChanged="OnCornerChanged"/>
                    <TextBlock Grid.Column="1" x:Name="CornerValue" Text="16 px"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </Grid>
                </Grid>
                <Border Height="1" Background="{DynamicResource SubtleBorderBrush}"/>
                <Grid ColumnDefinitions="180,*,180" ColumnSpacing="16">
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="h2" Text="轮盘不透明度"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="拖动滑块调整透明度；将鼠标移到右侧轮盘上可预览扇区高亮效果。"/>
                  </StackPanel>
                  <Grid Grid.Column="1" ColumnDefinitions="*,56" ColumnSpacing="8"
                        VerticalAlignment="Center">
                    <Slider x:Name="OpacitySlider" Minimum="30" Maximum="100" Value="96"
                            VerticalAlignment="Center" ValueChanged="OnOpacityChanged"/>
                    <TextBlock Grid.Column="1" x:Name="OpacityValue" Text="96%"
                               VerticalAlignment="Center" FontWeight="SemiBold"/>
                  </Grid>
                  <Border x:Name="ThemeDonutPreviewSurface" Grid.Column="2" Width="180" Height="180" Padding="7"
                          Background="{DynamicResource AccentFaintBrush}"
                          BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                          CornerRadius="{DynamicResource SoftRadius}" HorizontalAlignment="Center">
                    <ContentControl x:Name="ThemeDonutPreviewHost"
                                    IsHitTestVisible="False"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                </Grid>
                <Border Height="1" Background="{DynamicResource SubtleBorderBrush}"/>
                <Grid ColumnDefinitions="220,*" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h2" Text="减少动画"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="减少界面过渡效果以提高响应速度。"/>
                  </StackPanel>
                  <CheckBox Grid.Column="1" x:Name="ReduceMotionOption"
                            VerticalAlignment="Center" Content="减少动画"/>
                </Grid>
                <Border Height="1" Background="{DynamicResource SubtleBorderBrush}"/>
                <Grid ColumnDefinitions="220,*" ColumnSpacing="16">
                  <StackPanel Spacing="4">
                    <TextBlock Classes="h2" Text="窗口大小"/>
                    <TextBlock Classes="caption" TextWrapping="Wrap"
                               Text="调整 DFTDesk 主窗口的宽高（像素）。"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                  <WrapPanel Orientation="Horizontal">
                    <ComboBox x:Name="WindowSizePreset" SelectedIndex="0" Width="172"
                              SelectionChanged="OnWindowPresetChanged" Margin="0,0,10,6">
                      <ComboBoxItem Content="默认 1080 × 760"/>
                      <ComboBoxItem Content="宽屏 1440 × 900"/>
                      <ComboBoxItem Content="自定义"/>
                    </ComboBox>
                    <TextBox x:Name="WindowWidthInput" Text="1080" Width="77" Margin="0,0,5,6"/>
                    <TextBlock Text="×" Margin="0,4,5,0"/>
                    <TextBox x:Name="WindowHeightInput" Text="760" Width="77" Margin="0,0,8,6"/>
                    <Button Content="应用尺寸" Click="OnApplyWindowSize" Margin="0,0,0,6"/>
                  </WrapPanel>
                  <TextBlock x:Name="WindowSizeStatus" Classes="caption" TextWrapping="Wrap" Text=""/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="9">
              <Button Classes="accent" Content="保存设置" Click="OnThemeSave"/>
              <Button Content="恢复上次保存" Click="OnThemeCancel"/>
            </StackPanel>
          </StackPanel>

          <StackPanel x:Name="WorkEnginePage" Spacing="16" IsVisible="False">
            <TextBlock Classes="h1" Text="工作引擎"/>
            <Border Classes="card">
              <StackPanel Spacing="10">
                <TextBlock Classes="h2" Text="Python 环境"/>
                <TextBlock Classes="muted" TextWrapping="Wrap"
                           Text="以下五个工具独立显示、独立检测，使用同一个 Python 环境。更改环境路径后，可按需逐个检查。"/>
                <TextBlock Classes="label" Text="Python 可执行文件"/>
                <TextBox x:Name="AsePythonExecutable" Text="python"
                         PlaceholderText="python 或 C:\Python311\python.exe"
                         LostFocus="OnAsePathLostFocus"/>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="安装命令：python -m pip install ase pymatgen numpy matplotlib openpyxl"/>
              </StackPanel>
            </Border>
            <Grid ColumnDefinitions="*,14,*" RowDefinitions="Auto,14,Auto,14,Auto">
              <Border Grid.Row="0" Grid.Column="0" Classes="card">
                <StackPanel Spacing="9">
                  <TextBlock Classes="h2" Text="ASE"/>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="结构文件 POSCAR / CIF 转换、原子与团簇构型处理。"/>
                  <Button Classes="accent" HorizontalAlignment="Left"
                          Content="单独检测 ASE" Click="OnCheckAse"/>
                  <TextBlock x:Name="AseHealthText" Classes="caption" TextWrapping="Wrap"
                             Text="ASE：尚未检测。"/>
                </StackPanel>
              </Border>
              <Border Grid.Row="0" Grid.Column="2" Classes="card">
                <StackPanel Spacing="9">
                  <TextBlock Classes="h2" Text="pymatgen"/>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="VASP DOS / PDOS 与 LOBSTER COHP / ICOHP 数据解析。"/>
                  <Button Classes="accent" HorizontalAlignment="Left"
                          Content="单独检测 pymatgen" Click="OnCheckPymatgen"/>
                  <TextBlock x:Name="PymatgenHealthText" Classes="caption" TextWrapping="Wrap"
                             Text="pymatgen：尚未检测。"/>
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="0" Classes="card">
                <StackPanel Spacing="9">
                  <TextBlock Classes="h2" Text="NumPy"/>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="数值数组、DOS 积分和 d 带中心等计算。"/>
                  <Button Classes="accent" HorizontalAlignment="Left"
                          Content="单独检测 NumPy" Click="OnCheckNumpy"/>
                  <TextBlock x:Name="NumpyHealthText" Classes="caption" TextWrapping="Wrap"
                             Text="NumPy：尚未检测。"/>
                </StackPanel>
              </Border>
              <Border Grid.Row="2" Grid.Column="2" Classes="card">
                <StackPanel Spacing="9">
                  <TextBlock Classes="h2" Text="Matplotlib"/>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="DOS、COHP/ICOHP 曲线绘制和 PNG / SVG 导出。"/>
                  <Button Classes="accent" HorizontalAlignment="Left"
                          Content="单独检测 Matplotlib" Click="OnCheckMatplotlib"/>
                  <TextBlock x:Name="MatplotlibHealthText" Classes="caption" TextWrapping="Wrap"
                             Text="Matplotlib：尚未检测。"/>
                </StackPanel>
              </Border>
              <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Classes="card">
                <StackPanel Spacing="9">
                  <TextBlock Classes="h2" Text="openpyxl"/>
                  <TextBlock Classes="muted" TextWrapping="Wrap"
                             Text="将 DOS 与 COHP/ICOHP 数值数据导出为可编辑 Excel（.xlsx）工作簿。"/>
                  <Button Classes="accent" HorizontalAlignment="Left"
                          Content="单独检测 openpyxl" Click="OnCheckOpenpyxl"/>
                  <TextBlock x:Name="OpenpyxlHealthText" Classes="caption" TextWrapping="Wrap"
                             Text="openpyxl：尚未检测。"/>
                </StackPanel>
              </Border>
            </Grid>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="DFTDesk 不捆绑这些 Python 库；安装后在本页分别检测版本。ASE 采用 LGPL-2.1-or-later 许可。"/>
          </StackPanel>
          <StackPanel x:Name="AboutPage" Spacing="16" IsVisible="False">
            <TextBlock Classes="h1" Text="关于"/>
            <Border Classes="card">
              <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="DFTDesk"/>
                <TextBlock Text="DFT 计算工作台 · 结构转换、团簇生成、DOS / COHP / ICOHP 分析"/>
                <TextBlock Classes="caption" Text="DFTDesk 使用 MIT 许可；部分界面、轮盘及 Windows 文件组件源自上游开源项目，许可与原作者版权信息请见随附 LICENSE.txt 和源码中的第三方声明。"/>
                <TextBlock Classes="h2" Text="第三方开源组件"/>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="开源界面及轮盘源项目：Filee (KnifeLemon) — MIT License；原作者版权保留。"/>
                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="ASE — Atomic Simulation Environment（结构引擎，LGPL-2.1-or-later）；pymatgen、NumPy、Matplotlib、openpyxl — VASP DOS 与 LOBSTER 键分析（外部 Python 环境）。相关包不随 DFTDesk.exe 打包。"/>
                <Button Content="ASE 官方网站" HorizontalAlignment="Left" Click="OnOpenAseWebsite"/>
                <Button Content="DFTDesk" HorizontalAlignment="Left" Click="OnGitHub"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
        </ContentControl>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
