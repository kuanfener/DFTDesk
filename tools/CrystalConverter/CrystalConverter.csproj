<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WinForms SDK otherwise imports System.Drawing and System.Windows.Forms globally,
         making the original Avalonia DonutMenu types (Point, Control, Pen) ambiguous. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Filee.CrystalConverter</AssemblyName>
    <RootNamespace>Filee.CrystalConverter</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Win32.Interoperability" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" />
    <PackageReference Include="SharpHook" />
    <ProjectReference Include="../../src/Filee.Platform.Windows/Filee.Platform.Windows.csproj" />
    <Compile Include="../../src/Filee.App/Services/Triggers/GestureDetector.cs" Link="GestureDetector.cs" />
    <Compile Include="../../src/Filee.App/Services/Triggers/QueuedGlobalHook.cs" Link="QueuedGlobalHook.cs" />
    <!-- Link the original Filee donut; don't fork its rendering, hit-testing or animations. -->
    <Compile Include="../../src/Filee.App/Controls/DonutMenu*.cs" LinkBase="OriginalFileeDonut" />
    <Compile Include="../../src/Filee.App/Controls/DonutGeometry.cs" Link="OriginalFileeDonut/DonutGeometry.cs" />
    <Compile Include="../../src/Filee.App/Services/Motion.cs" Link="OriginalFileeDonut/Motion.cs" />
    <Compile Include="../../src/Filee.App/Services/KeyNames.cs" Link="OriginalFileeDonut/KeyNames.cs" />
    <!-- Filee's runtime palette math is the only source of truth for Soft and M3. -->
    <Compile Include="../../src/Filee.App/Services/SoftPalette.cs" Link="OriginalFileeThemes/SoftPalette.cs" />
    <Compile Include="../../src/Filee.App/Services/MaterialYouPalette.cs" Link="OriginalFileeThemes/MaterialYouPalette.cs" />
    <Compile Include="../../src/Filee.App/Services/AppLanguages.cs" Link="OriginalFileeThemes/AppLanguages.cs" />
    <EmbeddedResource Include="../../src/Filee.App/Assets/Icons/filee.png" LogicalName="Filee.CrystalConverter.FileeIcon.png" />
    <!-- The standalone shell uses the exact original Filee styles and icon paths. -->
    <AvaloniaResource Include="../../src/Filee.App/Styles/Soft.axaml" Link="Styles/Soft.axaml" />
    <AvaloniaResource Include="../../src/Filee.App/Styles/Icons.axaml" Link="Styles/Icons.axaml" />
    <AvaloniaResource Include="../../src/Filee.App/Assets/Icons/filee.png" Link="Assets/Icons/filee.png" />
    <AvaloniaResource Include="../../src/Filee.App/Assets/Icons/filee.ico" Link="Assets/Icons/filee.ico" />
  </ItemGroup>
</Project>
