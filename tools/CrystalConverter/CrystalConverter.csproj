<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Filee.CrystalConverter</AssemblyName>
    <RootNamespace>Filee.CrystalConverter</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 10pt</ApplicationDefaultFont>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SharpHook" />
    <ProjectReference Include="../../src/Filee.Platform.Windows/Filee.Platform.Windows.csproj" />
    <Compile Include="../../src/Filee.App/Services/Triggers/GestureDetector.cs" Link="GestureDetector.cs" />
    <Compile Include="../../src/Filee.App/Services/Triggers/QueuedGlobalHook.cs" Link="QueuedGlobalHook.cs" />
    <EmbeddedResource Include="../../src/Filee.App/Assets/Icons/filee.png" LogicalName="Filee.CrystalConverter.FileeIcon.png" />
  </ItemGroup>
</Project>
